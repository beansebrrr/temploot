:root {
  @utopia typeScale({
    minWidth: 360,
    maxWidth: 1240,
    minFontSize: 16,
    maxFontSize: 20,
    minTypeScale: 1.2,
    maxTypeScale: 1.25,
    positiveSteps: 5,
    negativeSteps: 2,
    prefix: "fs",
    relativeTo: "viewport-width"
  });

  @utopia spaceScale({
    minWidth: 360,
    maxWidth: 1240,
    minSize: 16,
    maxSize: 20,
    positiveSteps: [1.5, 2, 3, 4, 6],
    negativeSteps: [0.75, 0.5, 0.25],
    customSizes: ["s-l"],
    prefix: "space",
    relativeTo: "viewport-width",
  });
}
