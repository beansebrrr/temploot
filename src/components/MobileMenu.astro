---
import { Icon } from "astro-icon/components";
---

<button class="nav-menu__toggler nav-menu__open" type="button" command="show-modal" commandfor="navMenu">
  <Icon name="lucide:menu" />
</button>

<dialog class="nav-menu" id="navMenu">
  <button class="nav-menu__toggler" type="button" command="close" commandfor="navMenu">
    <Icon name="lucide:x" />
  </button>
  <nav>
    <ul>
      <li><a href="/about">About</a></li>
      <li><a href="/work">Work</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>
</dialog>

<style is:global>
  @layer components {

    .nav-menu__toggler {
      display: block;
      place-items: center;
      border-radius: 100vh;
      border: none;
      background-color: transparent;
      width: 2.5em;
      aspect-ratio: 1 / 1;
      cursor: pointer;
      position: relative;

      >[data-icon] {
        height: 50%;
        width: 50%;
        position: absolute;
        border-radius: 100vh;
        transform-origin: 50% 250%;
        inset: 25%;
      }
    }
  }
</style>