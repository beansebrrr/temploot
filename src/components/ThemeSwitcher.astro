---
import { Icon } from "astro-icon/components";
---

<button type="button" class="theme-switcher">
  <Icon name="lucide:moon" class="theme-switcher__dark" />
  <Icon name="lucide:sun" class="theme-switcher__light" />
</button>

<style is:global>
  @layer components {
    .theme-switcher {
      aspect-ratio: 1 / 1;
      border-radius: 100vh;
      border: none;
      background-color: var(--clr-surface-recessed);
      width: 2.5em;
      overflow: hidden;
      position: relative
    }
    
    .theme-switcher__light,
    .theme-switcher__dark {
      height: 50%;
      width: 50%;
      position: absolute;
      border-radius: 100vh;
      transform-origin: 50% 200%;
      inset: 25%;
      transition: transform 300ms ease;
    }
    
    :root:not([data-theme="dark"]) .theme-switcher__dark {
      transform: rotate(60deg);
    }
    
    :root[data-theme="dark"] .theme-switcher__light {
      transform: rotate(-60deg);
    }
  }
</style>

<script>
import { getTheme, setTheme } from "@utils/switch-theme";

  document.querySelectorAll(".theme-switcher").forEach($switcher => {
    $switcher.addEventListener("click", () => {
      setTheme(getTheme() === "light"
        ? "dark"
        : "light"
      )
    })
  })

</script>