{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@assets/*": ["./src/assets/*"],
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@styles/*": ["./src/styles/*"],
			"@scripts/*": ["./src/scripts/*"],
			"@utils/*": ["./src/utils/*"],
			"@constants": ["./src/utils/consts.ts"]
		}
	}
}
